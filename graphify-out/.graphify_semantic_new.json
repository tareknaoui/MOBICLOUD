    {
      "id": "concept_relay_proxy",
      "label": "Vite Dev Proxy for Relay CORS Avoidance",
      "file_type": "rationale",
      "source_file": "mobicloud-dashboard/vite.config.ts",
      "source_location": "L7-18",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "In dev mode all /relay requests are proxied to https://mobicloud-relay-3.onrender.com to avoid CORS and browser tracking protection blocks; in prod VITE_RELAY_URL is used directly."
    },
    {
      "id": "concept_polling_pattern",
      "label": "Short-Polling Pattern (setTimeout loop)",
      "file_type": "rationale",
      "source_file": "mobicloud-dashboard/src/hooks/useTopology.ts",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "All data hooks (useTopology, useHealth, useLogs, useClusters) use a cancelled-flag + setTimeout loop instead of setInterval to avoid overlapping requests and ensure cleanup on unmount."
    },
    {
      "id": "concept_sse_transfer",
      "label": "SSE Transfer Event Stream",
      "file_type": "rationale",
      "source_file": "mobicloud-dashboard/src/services/api.ts",
      "source_location": "L53-63",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Block/signal/election transfer events are pushed via SSE (/dashboard/events) so the GraphView2D can animate particles in real time without polling overhead."
    },
    {
      "id": "concept_particle_animation",
      "label": "Canvas Particle Animation for Transfer Events",
      "file_type": "rationale",
      "source_file": "mobicloud-dashboard/src/components/GraphView2D/index.tsx",
      "source_location": "L270-327",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A requestAnimationFrame loop on an overlay canvas animates colored glowing dots along edges to visualise block, signal, and election transfers between nodes in real time."
    },
    {
      "id": "concept_incremental_topology",
      "label": "Incremental Cytoscape Topology Update (no re-layout)",
      "file_type": "rationale",
      "source_file": "mobicloud-dashboard/src/components/GraphView2D/index.tsx",
      "source_location": "L334-497",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Topology diffs are applied incrementally: departed nodes are kept visible for 30 s with DEPART_TTL, edges are rebuilt only when active membership changes (mesh key), and cose-bilkent layout runs only once on first load to preserve user pan/zoom."
    },
    {
      "id": "concept_superpeer_topology",
      "label": "Super-Peer / Cluster Topology Visualisation",
      "file_type": "rationale",
      "source_file": "mobicloud-dashboard/src/components/GraphView2D/index.tsx",
      "source_location": "L11-14",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Super-peers are rendered as gold (yellow) compound-parent cluster nodes; regular members as blue dots. Full-mesh edges are drawn within each cluster to reflect the MobiCloud super-peer topology."
    },
    {
      "id": "concept_churn_rate",
      "label": "Churn Rate KPI",
      "file_type": "rationale",
      "source_file": "mobicloud-dashboard/src/App.tsx",
      "source_location": "L100-126",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Churn rate (departures / 5 min window) is surfaced prominently in the header and ClusterPanel; thresholds 15% (orange) and 30% (red) trigger visual warnings to indicate cluster instability."
    },
    {
      "id": "relay_server",
      "label": "MobiCloud Relay Server (mobicloud-relay-3.onrender.com)",
      "file_type": "rationale",
      "source_file": "mobicloud-dashboard/vite.config.ts",
      "source_location": "L10",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Single HA relay instance on Render.com; dashboard queries its REST metrics endpoints and SSE stream."
    }
  ],
